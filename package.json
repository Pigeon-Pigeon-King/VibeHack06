{
  "name": "return-to-ganymede",
  "version": "0.6.0",
  "author": "VibeHack06 contributors",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "audit:rig": "node --experimental-strip-types scripts/audit-character-rig.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5189 --strictPort",
    "test": "vitest run",
    "desktop": "electron .",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "check:transport": "vitest run --config scripts/transport-checks/vitest.config.ts",
    "check:escort": "vitest run --config scripts/escort-checks/vitest.config.ts",
    "check:finale": "vitest run --config scripts/finale-checks/vitest.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/three": "0.186.0",
    "electron": "45.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
