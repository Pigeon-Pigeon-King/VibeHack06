  "narration": {
    "status": "TEXT_DRAFT_NOT_RECORDED",
    "context": "成年闻川作品外旁白；不是新增战役对白",
    "speakerId": "lu.a19",
    "selectedRound01Id": "lu-b",
    "reference": "design/audio/campaign-voice-01/references/lu.a19/base.wav",
    "referenceSha256": "d7963e29f30e14a025fe259958fe0efb308dcd6283679e02fd1a0b65ec9a56ec",
    "timingStatus": "PROVISIONAL_BEFORE_RECORDING",
    "cues": [
      {
        "id": "trailer45.v2.01",
        "startSeconds": 0.5,
        "endSeconds": 4.8,
        "text": "我们盼着回归，已经十年了。"
      },
      {
        "id": "trailer45.v2.02",
        "startSeconds": 5.3,
        "endSeconds": 11.5,
        "text": "我忘不了爸爸。周延也忘不了他的班长。"
      },
      {
        "id": "trailer45.v2.03",
        "startSeconds": 13.0,
        "endSeconds": 17.8,
        "text": "地球的援军正在靠近。邵原，也要逃了。"
      },
      {
        "id": "trailer45.v2.04",
        "startSeconds": 18.5,
        "endSeconds": 21.5,
        "text": "追上去，还来得及。"
      },
      {
        "id": "trailer45.v2.05",
        "startSeconds": 23.5,
        "endSeconds": 27.6,
        "text": "可我答应过，要把这些人送到。"
      },
      {
        "id": "trailer45.v2.06",
        "startSeconds": 37.2,
        "endSeconds": 40.6,
        "text": "这一次，换我守住这扇门。"
      }
    ]
  },
